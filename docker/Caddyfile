# Caddy принимает запросы, сам выпускает и продлевает HTTPS-сертификат для домена
# (с http:// он сам переадресует на https://)
{$SITE_ADDRESS} {
	# Одно «зеркало» сайта для поисковиков: www.leon-pro.ru → leon-pro.ru (301)
	@www expression {host}.startsWith("www.")
	redir @www https://{labels.1}.{labels.0}{uri} permanent

	encode zstd gzip
	request_body {
		max_size 110MB
	}
	reverse_proxy web:80
}
